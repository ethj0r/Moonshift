{
  "name": "moonshift-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs && node scripts/prepare-fonts.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "prebuild": "npm run prepare:assets",
    "build": "tsc --noEmit && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
